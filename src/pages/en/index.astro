---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { ui } from '../../lib/site';
const lang = 'en' as const;
const t = ui.en;
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---
<BaseLayout title="Journal / Practical knowledge" description="Practical articles, guides and ideas you can put to use." lang={lang} active="home">
  <section class="hero"><div><div class="hero-kicker"><span class="status-dot"></span> Knowledge that works</div><h1>Less noise.<br/><em>More meaning.</em></h1><p class="hero-copy">Practical guides, technical notes and ideas you can apply right away.</p><div class="hero-actions"><a class="button" href="/en/blog/">Explore the articles ↗</a><a class="button button-secondary" href="/en/about/">About the author</a></div></div><div class="hero-visual" aria-hidden="true"><div class="orbit"></div><div class="visual-core">B.</div><div class="visual-label">Read / Learn / Build</div></div></section>
  <section class="section"><div class="section-heading"><div><span class="eyebrow">01 / Journal</span><h2>{t.latest}</h2></div><a class="text-link" href="/en/blog/">All articles ↗</a></div><div class="article-grid">{posts.map(post => <ArticleCard post={post} lang={lang} />)}</div>{posts.length === 0 && <div class="empty-state">Add English posts with <code>lang: en</code> to <code>src/content/blog/</code>.</div>}</section>
  <section class="section"><div class="about-strip"><div><span class="eyebrow">A little context</span><h2>Practical.<br/>Clear.<br/>Useful.</h2></div><p>Replace this text with a short introduction to your blog and the topics readers will find here.</p></div></section>
</BaseLayout>
