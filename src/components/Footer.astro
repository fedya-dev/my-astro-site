---
import { localPath, siteConfig, type Locale } from '../lib/site';
const { lang = 'bg' } = Astro.props as { lang?: Locale };
const year = new Date().getFullYear();
const isBg = lang === 'bg';
---
<footer class="site-footer">
  <div>
    <a class="footer-brand" href={localPath(lang)}>{siteConfig.title}<span aria-hidden="true">✳</span></a>
    <p>{isBg ? 'Практични идеи. Полезно съдържание. Без излишен шум.' : 'Practical ideas. Useful content. No unnecessary noise.'}</p>
  </div>
  <div class="footer-right">
    <span>© {year}</span>
    <a href={lang === 'en' ? '/en/rss.xml' : '/rss.xml'}>RSS</a>
    <a href={localPath(lang, 'about')}>{isBg ? 'За мен' : 'About'}</a>
    <a class="github-link" href="https://github.com/fedya-dev" target="_blank" rel="noopener noreferrer" aria-label={isBg ? 'Отвори GitHub профила на Fedya Serafiev (отваря се в нов раздел)' : 'Open Fedya Serafiev’s GitHub profile (opens in a new tab)'} title="GitHub · fedya-dev">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.08c-3.1.68-3.76-1.32-3.76-1.32-.5-1.3-1.23-1.65-1.23-1.65-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 .1.75 2.02 3.25 1.53.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.11-1.44 3.05-1.14 3.05-1.14.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.29-2.61 5.23-5.1 5.51.4.35.75 1.03.75 2.08V22c0 .29.2.63.76.53A11.1 11.1 0 0 0 12 .9Z"/></svg>
    </a>
  </div>
</footer>
