---
import BaseLayout from '../layouts/BaseLayout.astro'; import ArticleCard from '../components/ArticleCard.astro'; import {getCollection} from 'astro:content'; import {ui} from '../lib/site';
const lang='bg' as const;const t=ui.bg;const posts=(await getCollection('blog',({data})=>!data.draft&&data.lang===lang)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,6);
---
<BaseLayout title="Журнал / Практически знания" description="Практически статии, ръководства и идеи." lang={lang} active="home"><section class="hero"><div><div class="hero-kicker"><span class="status-dot"></span> Знание, което върши работа</div><h1>По-малко шум.<br/><em>Повече смисъл.</em></h1><p class="hero-copy">Практически ръководства, технически бележки и идеи, които можеш да приложиш веднага.</p><div class="hero-actions"><a class="button" href="/blog/">Разгледай статиите ↗</a><a class="button button-secondary" href="/about/">За автора</a></div></div><div class="hero-visual" aria-hidden="true"><div class="orbit"></div><div class="visual-core">B.</div><div class="visual-label">Чети / Учи / Създавай</div></div></section><section class="section"><div class="section-heading"><div><span class="eyebrow">01 / Блог</span><h2>{t.latest}</h2></div><a class="text-link" href="/blog/">Всички статии ↗</a></div><div class="article-grid">{posts.map(post=><ArticleCard post={post} lang={lang}/>)}</div>{posts.length===0&&<div class="empty-state">Добави публикации в <code>src/content/blog/</code>.</div>}</section><section class="section"><div class="about-strip"><div><span class="eyebrow">Редакционен принцип</span><h2>Практично.<br/>Проверено.<br/>Разбираемо.</h2></div><p>Този блог е създаден за съдържание с реална стойност. Замени текста с мисията на сайта и обясни на читателите какво ще намерят тук.</p></div></section></BaseLayout>
