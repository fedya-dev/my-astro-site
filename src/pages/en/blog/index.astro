---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import ArticleCard from '../../../components/ArticleCard.astro'; import { getCollection } from 'astro:content'; import { ui } from '../../../lib/site';
const lang='en' as const; const t=ui.en; const posts=(await getCollection('blog',({data})=>!data.draft&&data.lang===lang)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title={t.blog} description="Articles, notes and practical guides." lang={lang} active="blog"><header class="page-intro"><span class="eyebrow">Journal / 01</span><h1>Ideas, turned into <em>practice.</em></h1><p>Practical guides, notes and lessons from real work.</p></header><section class="section"><div class="search-box"><input type="search" id="site-search" placeholder={t.searchPlaceholder} aria-label={t.search}/><span class="eyebrow" style="align-self:center">{posts.length} POSTS</span></div><p class="search-status" id="search-status" aria-live="polite"></p><div class="article-grid" id="article-grid">{posts.map(post=><ArticleCard post={post} lang={lang}/>)}</div>{posts.length===0&&<div class="empty-state">Add a Markdown file to <code>src/content/blog/</code> with <code>lang: en</code>.</div>}</section><script>const input=document.querySelector<HTMLInputElement>('#site-search');const cards=[...document.querySelectorAll<HTMLElement>('#article-grid .article-card')];const status=document.querySelector<HTMLElement>('#search-status');input?.addEventListener('input',()=>{const q=input.value.trim().toLocaleLowerCase();let n=0;for(const card of cards){const ok=card.textContent?.toLocaleLowerCase().includes(q)??false;card.hidden=!ok;if(ok)n++}if(status)status.textContent=!q?'':n===0?'No results found.':`Results: ${n}`})</script></BaseLayout>
